# Booth Pi: cp to ~/.config/autostart/
[Desktop Entry]
Type=Application
Name=PhotoBouche control screen
# Restarts on crash. To stop it (loop included): pkill -f -- '--profile booth'
Exec=sh -c 'while true; do /home/pi/photobouche/.venv/bin/photobouche screen --profile booth; sleep 2; done'
X-GNOME-Autostart-enabled=true
